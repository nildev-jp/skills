---
import type { Review } from '../data/site';

interface Props {
  reviews: readonly Review[];
}

const { reviews } = Astro.props;
---

<section class="reviews" aria-labelledby="reviews-title" data-review-carousel>
  <div class="reviews__heading shell">
    <div class="google-source"><span class="google-g" aria-hidden="true">G</span> Google reviews</div>
    <h2 id="reviews-title">What guests say.</h2>
    <p>Keep the original tone of each review and the distinct perspective of every guest.</p>
  </div>

  <div class="reviews__viewport">
    <div class="reviews__stage" aria-live="polite" aria-atomic="true">
      {reviews.map((review, index) => (
        <article
          class="review-card"
          data-review
          data-state={index === 0 ? 'active' : index === 1 ? 'next' : index === reviews.length - 1 ? 'previous' : 'hidden'}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <header class="review-card__header">
            <span class="review-card__avatar" style={`--avatar: ${review.avatarColor}`}>{review.author.slice(0, 1)}</span>
            <div class="review-card__person">
              <strong>{review.author}</strong>
              {review.reviewerMeta && <span>{review.reviewerMeta}</span>}
            </div>
            <span class="google-g google-g--small" aria-label="Google review">G</span>
          </header>

          {(review.rating || review.relativeTime) && (
            <div class="review-card__rating">
              {review.rating && <span class="review-card__stars" aria-label={`${review.rating} stars`}>{'*'.repeat(review.rating)}</span>}
              {review.relativeTime && <span>{review.relativeTime}</span>}
            </div>
          )}

          <p class="review-card__text">{review.quote}{review.truncated && <span class="review-card__more"> More</span>}</p>

          {review.photos && review.photos.length > 0 && (
            <div class="review-card__photos">
              {review.photos.map((photo, photoIndex) => (
                <img src={photo} alt={`${review.author} review photo ${photoIndex + 1}`} width="240" height="160" loading="lazy" />
              ))}
            </div>
          )}

          <footer class="review-card__footer">
            <span>Helpful?</span>
            <button type="button" aria-label={`Mark ${review.author}'s review as helpful`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 21H3V9h4v12Zm0-10 5-8c1.2 0 2 .9 2 2v4h5a2 2 0 0 1 2 2l-2 8a2 2 0 0 1-2 2H7V11Z" /></svg>Yes
            </button>
            <button type="button" aria-label={`Share ${review.author}'s review`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4" /></svg>Share
            </button>
          </footer>
        </article>
      ))}
    </div>
  </div>

  <div class="reviews__controls shell">
    <button type="button" data-review-previous aria-label="Show previous review"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
    <div class="reviews__dots" aria-label="Choose a review">
      {reviews.map((_, index) => <button type="button" data-review-dot={index} aria-label={`Show review ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'}></button>)}
    </div>
    <button type="button" data-review-next aria-label="Show next review"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
  </div>
</section>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-review-carousel]');

  const initializeCarousel = (carousel: HTMLElement): void => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-review]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-review-dot]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-review-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-review-next]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let currentIndex = 0;
    let timer: number | undefined;

    const getState = (index: number): 'active' | 'previous' | 'next' | 'hidden' => {
      const offset = (index - currentIndex + slides.length) % slides.length;
      if (offset === 0) return 'active';
      if (offset === 1) return 'next';
      if (offset === slides.length - 1) return 'previous';
      return 'hidden';
    };

    const render = (nextIndex: number): void => {
      currentIndex = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const state = getState(index);
        slide.dataset.state = state;
        slide.setAttribute('aria-hidden', String(state !== 'active'));
      });
      dots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === currentIndex)));
    };

    const stop = (): void => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = (): void => {
      stop();
      if (slides.length < 2 || reducedMotion.matches || document.hidden) return;
      timer = window.setInterval(() => render(currentIndex + 1), 7000);
    };

    previous?.addEventListener('click', () => { render(currentIndex - 1); start(); });
    next?.addEventListener('click', () => { render(currentIndex + 1); start(); });
    dots.forEach((dot, index) => dot.addEventListener('click', () => { render(index); start(); }));
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', start);
    reducedMotion.addEventListener('change', start);
    start();
  };

  carousels.forEach(initializeCarousel);
</script>
